#!/bin/sh
# pre-commit: reject commits whose committer.name is explicitly overridden.
# Install: scripts/hooks/install.sh
# Ruling B (2026-09-03 架构侧裁决): 不得使用不同 committer.name。
#
# Strategy: if GIT_COMMITTER_NAME is set in the environment, it must match
# the name git would use without the override (from config or auto-detect).
# When GIT_COMMITTER_NAME is unset, git uses its default — always allowed.

if [ -z "$GIT_COMMITTER_NAME" ]; then
  exit 0
fi

# Get the default committer name (without GIT_COMMITTER_NAME override).
# git var GIT_COMMITTER_IDENT returns "Name <email> timestamp tz".
# We temporarily unset GIT_COMMITTER_NAME to get the true default.
default_ident=$(env -u GIT_COMMITTER_NAME git var GIT_COMMITTER_IDENT 2>/dev/null)
default_name=$(echo "$default_ident" | sed 's/ *<.*//')

if [ -z "$default_name" ]; then
  # Cannot determine default — skip check rather than block all commits.
  exit 0
fi

if [ "$GIT_COMMITTER_NAME" != "$default_name" ]; then
  echo "[pre-commit] committer.name mismatch: expected '$default_name', got '$GIT_COMMITTER_NAME'"
  echo "[pre-commit] Rejecting commit. Unset GIT_COMMITTER_NAME or match the default."
  exit 1
fi

exit 0
