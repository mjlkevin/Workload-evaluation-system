{
  "name": "workload-evaluation-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api"
  ],
  "scripts": {
    "board:branches": "node scripts/generate-branch-board.js",
    "board:build": "node scripts/board-build.js",
    "board:check": "node scripts/board-consistency-check.js",
    "board:archive": "node scripts/board-archive-changes.js",
    "board:branches:check": "node scripts/generate-branch-board.js --check && node --test scripts/branch-board.test.js scripts/branch-board-page.test.js",
    "test:board:branches": "node --test scripts/branch-board.test.js scripts/branch-board-page.test.js",
    "test:security": "node --test scripts/check-tracked-secrets.test.js && npx tsx --test apps/api/src/services/ai/knowledge-base-url-policy.test.ts && node scripts/check-tracked-secrets.js",
    "dev:web": "npm run dev --prefix ui/V2_PROTOTYPE",
    "dev:api": "npm run dev -w apps/api",
    "dev:recover": "bash scripts/recover-dev.sh",
    "tunnel:api": "bash scripts/tunnel-api-cloudflared.sh",
    "tunnel:web": "bash scripts/tunnel-web-cloudflared.sh",
    "tunnel:api:ngrok": "bash scripts/tunnel-api-ngrok.sh",
    "tunnel:web:ngrok": "bash scripts/tunnel-web-ngrok.sh",
    "tunnel:api:lt": "bash scripts/tunnel-api-localtunnel.sh",
    "tunnel:web:lt": "bash scripts/tunnel-web-localtunnel.sh",
    "build:web": "npm run build --prefix ui/V2_PROTOTYPE",
    "build:api": "npm run build -w apps/api",
    "rules:standardize": "node scripts/standardize-rules-from-excel.js",
    "rules:regression": "node scripts/rule-regression-check.js",
    "rules:excel-report": "node scripts/excel-regression-report.js",
    "test:api:integration": "node scripts/api-integration-check.js",
    "test:api:team": "node scripts/team-api-check.js",
    "test:ai": "npm run test:ai -w apps/api",
    "test:modules": "npm run test:modules -w apps/api",
    "test:modules:serial-store": "npm run test:modules:serial-store -w apps/api",
    "test:rules": "npm run test:rules -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:agent": "npm run test:agent -w apps/api",
    "test:web": "npm run test --prefix ui/V2_PROTOTYPE",
    "test:bundle": "bash scripts/run-test-bundle.sh",
    "ops:backup:config": "node scripts/backup-config.js",
    "test:all": "npm run test:modules && npm run test:modules:serial-store && npm run test:rules && npm run test:integration && npm run rules:regression && npm run rules:excel-report",
    "test:e2e:web": "npm run test:web"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
