# ============================================================
# Workload Evaluation System — 环境变量模板
# 使用方式：
#   cp .env.example .env
#   # 编辑 .env，填入真实值
# ============================================================

# ------------------------------
# 服务端口（通常保持默认）
# ------------------------------
PORT=3000

# ------------------------------
# PostgreSQL 数据库
# ------------------------------
# 开发/生产连接串。Docker 编排时自动指向 db 服务：
#   postgres://workload:workload@db:5432/workload_eval
# 本地直连（非 Docker）：
#   postgres://用户名@localhost:5432/workload_eval
DATABASE_URL=postgres://workload:workload@db:5432/workload_eval
# 连接池上限。最小值为 2（启动迁移时 advisory lock 占 1 条 + 迁移执行占 1 条，
# 设为 1 会发生自锁死；详见 apps/api/src/db/migrate.ts 头注释）
DATABASE_POOL_MAX=10

# Docker Compose 内部使用（仅在 docker-compose.yml 中读取）
POSTGRES_USER=workload
POSTGRES_PASSWORD=workload
POSTGRES_DB=workload_eval

# ------------------------------
# JWT 认证
# ------------------------------
# 生产环境务必更换为强随机字符串
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=8h

# ------------------------------
# Kimi（Moonshot）AI 服务
# ------------------------------
# 必填：从 Moonshot 控制台获取的 API Key
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：模型名称
KIMI_MODEL=kimi-k2.5
# 可选：API 基础地址
KIMI_API_BASE_URL=https://api.moonshot.cn/v1

# ------------------------------
# 启动行为
# ------------------------------
# S7（2026-08-31，D15 执行）：`CONFIG_INTEGRITY_ON_STARTUP` 已退役删除。
# 启动期配置完整性校验（ops/config-integrity.ts + ops:config:check CLI）已整链下线：
# 九域 JSON 读写路径删除后 REQUIRED_FILES 已清空，校验器实跑仅输出 checked 0 files。
# 配置正确性现由 DB 侧承载（migrate fail-fast + seed 守卫 + 防漂移测试），无需环境变量。

# ------------------------------
# 阶段 2 存储切换（批 1：Auth 域已切 PG）
# ------------------------------
# 邀请码 + 密码重置令牌已于批 1 第 4 步完成切换，WES_STORE_AUTH_PG 开关已退役；
# JSON 读写路径已删除，config/auth/invite-codes.json 归档至 99_归档/。
# 后续批次沿用 WES_STORE_<DOMAIN>_PG 命名（严格 "true"、缺省 JSON、记忆化单例）。

# 阶段 2 批 2：users 域选择器（登录热路径）
# S1（2026-08-25）已删 JSON 实现与 usersStorePath，users 域恒 PostgreSQL（users 表），
# 开关保留至 S7 统一退役（D18 裁决：users 属可废止时间下限域，操作覆盖已完成即开工）。
# 开关进程内只读一次，翻开关需重启。
# WES_STORE_USERS_PG=true
