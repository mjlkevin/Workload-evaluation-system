# ============================================================
# apps/api 环境变量模板
# ============================================================
# 实际使用时 copy 为 .env.local（.gitignore 已豁免 .env.example）

# 服务端口
PORT=3000

# JWT
# 生产环境必须设置为至少 32 字节的随机值，例如：openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=8h

# Kimi（Moonshot）
# 仅在 .env.local / 部署密钥管理中填写真实 Key，禁止提交到 Git。
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
KIMI_API_BASE_URL=https://api.moonshot.cn/v1

# 智谱 AI（知识库检索）
# 仅在 .env.local / 部署密钥管理中填写真实 Key，禁止提交到 Git。
# 详见 docs/智谱AI知识库集成指南.md
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6
ZHIPU_KNOWLEDGE_ID=2057857904412954624
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# PostgreSQL
# 开发库；测试运行时会用独立库 workload_eval_test（不写这里）
DATABASE_URL=postgres://kevin@localhost:5432/workload_eval
DATABASE_POOL_MAX=10

# Harness 异步通道（durable runs）开关，main.ts / routes 读取
# true=发问走异步 run（后台任务角标 + run 事件流逐字/思考）；缺省/false=同步流式路径
WES_AI_DURABLE_RUNS_ENABLED=true
